# Exponential Growth Engine - Zion Tech Group
# Runs continuously with adaptive timing for maximum autonomous growth

# Main growth engine - runs every 5 minutes
*/5 * * * * cd /Users/klebergarciaalcatrao/zion-support.github.io && source ~/.nvm/nvm.sh && nvm use && PYTHONPATH=/Users/klebergarciaalcatrao python3 scripts/growth-automation/exponential_growth_engine.py >> logs/growth_engine.log 2>&1

# Service innovation engine - runs every hour for new service discovery
0 * * * * cd /Users/klebergarciaalcatrao/zion-support.github.io && source ~/.nvm/nvm.sh && nvm use && OPENROUTER_API_KEY=$OPENROUTER_API_KEY python3 scripts/autonomous_service_innovation_engine.py >> logs/service_innovation.log 2>&1

# High-frequency email monitoring - runs every 2 minutes
*/2 * * * * cd /Users/klebergarciaalcatrao && python3 scripts/outreach/minimal_high_frequency_monitor.py >> logs/high_frequency_monitor.log 2>&1

# Performance review - runs every 4 hours
0 */4 * * * cd /Users/klebergarciaalcatrao/zion-support.github.io && python3 scripts/growth-automation/performance_review.py >> logs/performance_review.log 2>&1

# Website deployment - runs every 30 minutes to deploy new services
*/30 * * * * cd /Users/klebergarciaalcatrao/zion-support.github.io && npm run build:ci && git add -A && git commit -m "Auto: growth engine update [$(date +%Y%m%d%H%M%S)]" && git push origin hero-carousel 2>/dev/null || true

# Health check - runs every 15 minutes
*/15 * * * * cd /Users/klebergarciaalcatrao/zion-support.github.io && curl -s -o /dev/null -w "%{http_code}" https://ziontechgroup.com/ | grep -q "200" || echo "Site down!" | mail -s "Zion Site Alert" kleber@ziontechgroup.com