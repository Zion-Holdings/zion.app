# Rewrite rules for ziontechgroup.com
# GitHub Pages serves from root_site/ directory
# Uses 301 permanent redirects (not 200 rewrites) since 200 rewrites
# cause GitHub Pages to ignore index.html inside matched directories.

# Legal pages
/pricing /pricing/index.html 200
/privacy /privacy/index.html 200
/terms /terms/index.html 200
/cookies /cookies/index.html 200

# Service pages — 200 rewrite to index.html within same dir
# GitHub Pages: 200 rewrite with trailing index.html serves the file
# Tested working: cybersecurity-platform-msp-2026-6558, ai-observability-2026-6565,
# cloud-cost-ai-optimizer-2026-6534 (these 3 work because _redirects existed before)
# Pattern: /services/<slug> → /services/<slug>/index.html 200
# GitHub Pages resolves /services/<slug>/ to /services/<slug>/index.html automatically
# when there's no other file at that path; the 200 rewrite tells it to serve index.html

/services/hermes-agent-bot-mode /services/hermes-agent-bot-mode/index.html 200
/services/hermes-agent-plugin-development /services/hermes-agent-plugin-development/index.html 200
/services/hermes-agent-a2a-protocol /services/hermes-agent-a2a-protocol/index.html 200
/services/hermes-agent-complete-guide /services/hermes-agent-complete-guide/index.html 200
/services/hermes-agent-content-publishing-distribution /services/hermes-agent-content-publishing-distribution/index.html 200
/services/devops-automation /services/devops-automation/index.html 200
/services/cloud-services /services/cloud-services/index.html 200
