{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./app/*"
      ]
    },
    "types": [
      "node"
    ],
    "strictNullChecks": true
  },
  "include": [
    "app/**/*.tsx",
    "app/**/*.ts",
    "components/**/*.tsx",
    "components/**/*.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src",
    "zion.app",
    "apps",
    "archive",
    "jest.setup.ts",
    "jest.setup.cjs",
    "__tests__",
    "**/*.test.*",
    "**/*.spec.*",
    "tools",
    "utils",
    "lib",
    "commands",
    "engines",
    "out",
    ".next",
    "docs",
    "automation",
    "public",
    "scripts",
    "app/data",
    "app/routes",
    "app/zion-ai-*",
    "app/services/*/"
  ]
}
