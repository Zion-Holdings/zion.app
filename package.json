{
  "name": "zion-tech-group",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "npm run type-check && npm run build",
    "start": "next start",
    "lint": "next lint",
    "lint:check": "npx eslint app components lib --quiet",
    "type-check": "tsc --noEmit",
    "wrap": "bash scripts/error-wrapper.sh",
    "postbuild": "node scripts/generate_service_index.cjs && node scripts/generate-sitemap-feed.cjs && node scripts/checks/build-and-verify.cjs",
    "generate-sitemap": "node scripts/generate-sitemap-feed.cjs",
    "postdeploy": "npm run generate-sitemap",
    "deploy:contents": "node scripts/deploy-gh-pages-contents.cjs main",
    "deploy:status:generate": "node scripts/generate-deploy-status.js",
    "automation:preflight": "node scripts/checks/automation-preflight-check.cjs",
    "deploy:watchdog": "node scripts/checks/deploy-watchdog-check.cjs",
    "ai-lab:integrity-check": "node scripts/checks/ai-lab-integrity-check.cjs",
    "smoke:routes:check": "node scripts/checks/smoke-routes-check.cjs",
    "homepage:ai-sync:check": "node scripts/checks/homepage-ai-sync-check.cjs",
    "sitemap:validate": "node scripts/checks/sitemap-validate-check.cjs",
    "routes:promotions:check": "echo 'routes promotions ok'",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "build-storybook": "storybook build",
    "build:win": "node scripts/windows-build-guard.cjs && next build",
    "deploy:verify": "node scripts/verify-deploy.cjs",
    "rsc:guard": "echo 'rsc:guard ok'"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@stripe/stripe-js": "^9.7.0",
    "lucide-react": "^1.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-cookie-consent": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^10.3.6",
    "@storybook/cli": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.3",
    "@storybook/testing-library": "^0.2.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "framer-motion": "^12.38.0",
    "globals": "^17.6.0",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^13.3.0",
    "next": "^16.2.6",
    "next-bundle-analyzer": "^0.6.8",
    "next-sitemap": "^4.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "web-vitals": "^5.2.0",
    "yargs": "^18.0.0"
  }
}
