{
  "name": "zion-tech-group",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "bash -c 'ulimit -n 131072 2>/dev/null || true; NEXT_TURBOPACK_USE_WORKER=0 exec npx next build'",
    "build:ci": "bash -c 'ulimit -n 131072 2>/dev/null || true; node scripts/build-wrapper.cjs'",
    "build:check": "npm run type-check && node scripts/build-wrapper.cjs",
    "start": "next start",
    "lint": "next lint",
    "lint:check": "bash -c 'ulimit -n 131072 2>/dev/null || true; npx eslint app components --quiet'",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "wrap": "bash scripts/error-wrapper.sh",
    "postbuild": "node scripts/generate_service_index.cjs && node scripts/generate-sitemap-feed.cjs && node scripts/checks/build-and-verify.cjs",
    "generate-sitemap": "node scripts/generate-sitemap-feed.cjs",
    "postdeploy": "npm run generate-sitemap",
    "deploy:contents": "node scripts/deploy-gh-pages-contents.cjs main",
    "deploy:status:generate": "node scripts/generate-deploy-status.js",
    "automation:preflight": "node scripts/checks/automation-preflight-check.cjs",
    "deploy:watchdog": "node scripts/checks/deploy-watchdog-check.cjs",
    "ai-lab:integrity-check": "node scripts/checks/ai-lab-integrity-check.cjs",
    "smoke:routes:check": "node scripts/checks/smoke-routes-check.cjs",
    "homepage:ai-sync:check": "node scripts/checks/homepage-ai-sync-check.cjs",
    "sitemap:validate": "node scripts/checks/sitemap-validate-check.cjs",
    "routes:promotions:check": "echo 'routes promotions ok'",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "build-storybook": "storybook build",
    "build:win": "node scripts/windows-build-guard.cjs && next build",
    "deploy:verify": "node scripts/verify-deploy.cjs",
    "rsc:guard": "echo 'rsc:guard ok'",
    "lighthouse:production": "npx lighthouse https://ziontechgroup.com --chrome-flags='--headless --no-sandbox --disable-gpu' --output=json --output-path=automation/reports/lighthouse-production-latest.json",
    "pin-actions": "node scripts/automation/validate-pin-actions.cjs",
    "workflows:contracts:node": "node scripts/automation/workflow-contracts.cjs",
    "lint:fix": "next lint --fix",
    "deploy:readiness": "node scripts/checks/deploy-readiness.cjs",
    "automation:health": "node scripts/checks/automation-health.cjs",
    "cron:health": "node scripts/checks/cron-health.cjs"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@stripe/stripe-js": "^9.7.0",
    "lucide-react": "^1.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-cookie-consent": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^10.3.6",
    "@storybook/cli": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.3",
    "@storybook/testing-library": "^0.2.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "framer-motion": "^12.38.0",
    "globals": "^17.6.0",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^13.3.0",
    "next": "^16.2.10",
    "next-bundle-analyzer": "^0.6.8",
    "next-sitemap": "^4.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "7.0.2",
    "web-vitals": "^5.2.0",
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": "22"
  },
  "overrides": {
    "js-yaml": "^3.15.0",
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1",
    "postcss": "^8.5.10"
  }
}
