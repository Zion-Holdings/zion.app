name: Mirror main build to gh-pages branch

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: write
  pages: write
  id-token: write

jobs:
  mirror:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - name: Build static artifact
        run: |
          set -euo pipefail
          rm -rf out
          mkdir -p out/docs out/public
          [ -d docs ] && cp -Rf docs/. out/docs/ || true
          [ -d public ] && cp -Rf public/. out/public/ || true
          find . -maxdepth 1 \( -name '*.html' -o -name '*.xml' -o -name '*.txt' -o -name '*.json' -o -name '*.svg' -o -name '*.ico' -o -name '*.png' \) -type f -exec cp -f {} out/ \;
          [ -f _headers ] && cp -f _headers out/_headers || true
          [ -f CNAME ] && cp -f CNAME out/CNAME || true
          echo "=== Artifact contents ==="
          ls -la out/ | head -20
          echo "=== Total files ==="
          find out -type f | wc -l

      - name: Deploy to gh-pages
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./out
          keep_files: false
          user_name: Zion CI
          user_email: ci@ziontechgroup.com
