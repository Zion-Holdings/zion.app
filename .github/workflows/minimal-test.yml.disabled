name: Minimal Build Test
on:
  workflow_dispatch:
  push:
    branches:
      - main
jobs:
  minimal:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v6.0.2
      - uses: actions/setup-node@v6.3.0
        with:
          node-version: '20'
          cache: npm
      - run: rm -rf node_modules .next out
      - run: npm install --no-audit --fund=false
      - run: npm run build -- --webpack
